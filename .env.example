# —— 网关（多用户）——
# 数据目录：Railway 上挂 Volume 到 /data，这里填 /data（必须，否则重启后所有人登录和持仓记录都会丢）
DATA_DIR=/data
# 同时运行的终端进程上限（每个约 100–120MB 内存；Railway 试用 1GB 建议 ≤5）
MAX_PROCS=5
# 会话目录上限
MAX_USERS=200
# 多少分钟没打开页面就停掉该用户的进程（勾了「离开后保持运行」的除外）
IDLE_MIN=30
# 多少天没来访就在币安登出并删除会话
SESSION_DAYS=7
# 邀请码：设了就只有知道邀请码的人能进（强烈建议设置）
ACCESS_CODE=

# —— 传给每个 TMTN 进程的共享配置 ——
# 1 = 真实下单（只接受页面上手动点击的订单）；0 = 只报价 / 预演
LIVE_TRADE=1
# 单笔买入上限（BNB）初始值，用户可在页面里改
MAX_TRADE_BNB=0.5
# 私有节点（强烈建议，多用户共用公共节点很容易被限流）：例如 https://bsc-mainnet.nodereal.io/v1/<你的key>
NODEREAL_RPC=
# 不填 NODEREAL_RPC 时默认只回扫 20000 块 Four 新盘；填了默认 150000
FOUR_BACKFILL_BLOCKS=
